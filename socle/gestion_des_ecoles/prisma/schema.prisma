generator client {
  provider      = "prisma-client-js"
  // Alpine (Docker prod) + machine locale (dev mac/linux)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== ENUMS ==============

enum Role {
  ADMIN
  DIRECTEUR
  PROFESSEUR
  PREFET
  PARENT
  ELEVE
}

enum TypeProfesseur {
  MATIERE
  PRIMAIRE
}

enum FamilleCycle {
  PRIMAIRE
  COLLEGE
  SECONDAIRE
}

enum Sexe {
  M
  F
}

enum TypeEvaluation {
  DEVOIR
  COMPOSITION
  INTERROGATION
  TP
}

enum PeriodeJournee {
  MATIN
  APRES_MIDI
  JOURNEE
}

enum TypeAppreciation {
  MATIERE
  GENERALE
  CONSEIL_CLASSE
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
}

enum DestinataireCommunique {
  PARENTS
  PROFESSEURS
  TOUS
}

enum TypeEvenementJour {
  ABSENCE_PERSONNEL
  RETARD_PERSONNEL
  PERTURBATION
}

// ============== MODELS ==============

model User {
  id            String    @id @default(cuid())
  nom           String
  prenom        String
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          Role      @default(PROFESSEUR)
  telephone     String?
  adresse       String?
  photo         String?
  actif         Boolean   @default(true)
  ecoleId       String?          @map("ecole_id")
  typeProfesseur TypeProfesseur? @map("type_professeur")
  familleCycle  FamilleCycle?    @map("famille_cycle")
  twoFactorEnabled Boolean       @default(false) @map("two_factor_enabled")
  mustChangePassword Boolean     @default(false) @map("must_change_password")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  ecole        Ecole?        @relation(fields: [ecoleId], references: [id])
  evaluations  Evaluation[]
  notes        Note[]
  absences     Absence[]
  bulletins    Bulletin[]
  logs         LogActivite[]
  sessions     Session[]
  accounts     Account[]
  parentEleves ParentEleve[]
  eleve        Eleve?
  twoFactorChallenges TwoFactorChallenge[]
  creneauxEdt  CreneauEdt[]
  communiques  Communique[]
  evenementsPersonnel EvenementJour[] @relation("EvenementPersonnel")
  evenementsSaisis    EvenementJour[] @relation("EvenementAuteur")
  notesAgenda         NoteAgenda[]
  filsParent          FilMessage[]    @relation("FilParent")
  filsProfesseur      FilMessage[]    @relation("FilProfesseur")
  messages            Message[]
  filsStaffDirecteur  FilStaff[]      @relation("FilStaffDirecteur")
  filsStaffPrefet     FilStaff[]      @relation("FilStaffPrefet")
  messagesStaff       MessageStaff[]
  classesPrincipal    Classe[]        @relation("ClasseProfPrincipal")
  professeurMatieres  ProfesseurMatiere[]
  convocationsCreees  Convocation[]   @relation("ConvocationAuteur")
  tokenRevocations    TokenRevocation[]
  loginAttempts       LoginAttempt[]

  @@index([ecoleId])
  @@index([telephone])
  @@map("users")
}

model Ecole {
  id               String  @id @default(cuid())
  nom              String
  nomOfficiel      String? @map("nom_officiel")
  sigle            String?
  ville            String
  adresse          String?
  telephone        String?
  email            String?
  actif            Boolean @default(true)
  montantMensuel   Int?    @map("montant_mensuel")
  montantAnnuel    Int?    @map("montant_annuel")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  classes         Classe[]
  eleves          Eleve[]
  creneauxEdt     CreneauEdt[]
  communiques     Communique[]
  evenementsJour  EvenementJour[]
  notesAgenda     NoteAgenda[]
  filsMessages    FilMessage[]
  filsStaff       FilStaff[]
  cycles          EcoleCycle[]
  grillesHoraires GrilleHoraire[]
  convocations    Convocation[]

  @@map("ecoles")
}

model EcoleCycle {
  id      String       @id @default(cuid())
  ecoleId String       @map("ecole_id")
  famille FamilleCycle

  ecole Ecole @relation(fields: [ecoleId], references: [id], onDelete: Cascade)

  @@unique([ecoleId, famille])
  @@map("ecole_cycles")
}

model GrilleHoraire {
  id         String       @id @default(cuid())
  ecoleId    String       @map("ecole_id")
  famille    FamilleCycle
  heureDebut String       @map("heure_debut")
  heureFin   String       @map("heure_fin")
  ordre      Int          @default(0)

  ecole Ecole @relation(fields: [ecoleId], references: [id], onDelete: Cascade)

  @@unique([ecoleId, famille, heureDebut, heureFin])
  @@index([ecoleId, famille])
  @@map("grilles_horaires")
}

enum ConvocationStatut {
  ENVOYEE
  VUE
}

model Convocation {
  id               String            @id @default(cuid())
  ecoleId          String            @map("ecole_id")
  classeId         String            @map("classe_id")
  eleveId          String            @map("eleve_id")
  createdById      String            @map("created_by_id")
  dateConvocation  DateTime          @map("date_convocation")
  motif            String            @db.Text
  nomTuteur        String?           @map("nom_tuteur")
  telephoneTuteur  String?           @map("telephone_tuteur")
  emailTuteur      String?           @map("email_tuteur")
  statut           ConvocationStatut @default(ENVOYEE)
  createdAt        DateTime          @default(now()) @map("created_at")

  ecole     Ecole  @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  classe    Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)
  eleve     Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ConvocationAuteur", fields: [createdById], references: [id])

  @@index([ecoleId, dateConvocation])
  @@index([eleveId])
  @@map("convocations")
}

model TwoFactorChallenge {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_challenges")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Cycle {
  id          String        @id @default(cuid())
  nom         String
  description String?
  ordre       Int
  famille     FamilleCycle  @default(PRIMAIRE)

  classes Classe[]

  @@map("cycles")
}

model Classe {
  id            String @id @default(cuid())
  nom           String
  niveau        String
  anneeScolaire String @map("annee_scolaire")
  effectifMax   Int    @default(40) @map("effectif_max")
  cycleId       String? @map("cycle_id")
  ecoleId       String  @map("ecole_id")
  salle         String?
  professeurPrincipalId String? @map("professeur_principal_id")

  createdAt DateTime @default(now())

  // Relations
  ecole          Ecole           @relation(fields: [ecoleId], references: [id])
  cycle          Cycle?          @relation(fields: [cycleId], references: [id])
  professeurPrincipal User?      @relation("ClasseProfPrincipal", fields: [professeurPrincipalId], references: [id], onDelete: SetNull)
  eleves         Eleve[]
  evaluations    Evaluation[]
  classeMatieres ClasseMatiere[]
  creneauxEdt    CreneauEdt[]
  convocations   Convocation[]

  @@index([ecoleId])
  @@index([professeurPrincipalId])
  @@map("classes")
}

model Eleve {
  id            String   @id @default(cuid())
  nom           String
  prenom        String
  dateNaissance DateTime @map("date_naissance")
  lieuNaissance String?  @map("lieu_naissance")
  sexe          Sexe

  // Compte utilisateur lié (pour connexion élève)
  userId        String?  @unique @map("user_id")
  user          User?    @relation(fields: [userId], references: [id])

  // Parents
  nomPere         String? @map("nom_pere")
  telephonePere   String? @map("telephone_pere")
  nomMere         String? @map("nom_mere")
  telephoneMere   String? @map("telephone_mere")
  nomTuteur       String? @map("nom_tuteur")
  telephoneTuteur String? @map("telephone_tuteur")
  emailParent     String? @map("email_parent")

  classeId  String  @map("classe_id")
  ecoleId   String  @map("ecole_id")
  matricule String  @unique
  adresse   String?
  photo     String?
  groupeSanguin String? @map("groupe_sanguin")
  allergies     String?
  telephoneSecours String? @map("telephone_secours")
  lienTuteur       String? @map("lien_tuteur")
  actif     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  ecole             Ecole             @relation(fields: [ecoleId], references: [id])
  classe            Classe            @relation(fields: [classeId], references: [id])
  notes             Note[]
  absences          Absence[]
  bulletins         Bulletin[]
  moyennesMatieres  MoyenneMatiere[]
  moyennesGenerales MoyenneGenerale[]
  appreciations     Appreciation[]
  parentEleves      ParentEleve[]
  paiements         Paiement[]
  filsMessages      FilMessage[]
  convocations      Convocation[]

  @@index([ecoleId])
  @@map("eleves")
}

model ParentEleve {
  id        String @id @default(cuid())
  parentId  String @map("parent_id")
  eleveId   String @map("eleve_id")
  relation  String @default("parent") // parent, tuteur, pere, mere

  createdAt DateTime @default(now())

  parent User  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  eleve  Eleve @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@unique([parentId, eleveId])
  @@map("parent_eleves")
}

model DomaineApprentissage {
  id          String  @id @default(cuid())
  nom         String
  code        String  @unique
  description String?
  ordre       Int

  matieres Matiere[]

  @@map("domaines_apprentissage")
}

model Matiere {
  id          String  @id @default(cuid())
  nom         String
  code        String  @unique
  coefficient Decimal @default(1.00) @db.Decimal(3, 2)
  couleur     String?
  domaineId   String? @map("domaine_id")

  createdAt DateTime @default(now())

  // Relations
  domaine          DomaineApprentissage? @relation(fields: [domaineId], references: [id])
  evaluations      Evaluation[]
  classeMatieres   ClasseMatiere[]
  moyennesMatieres MoyenneMatiere[]
  appreciations    Appreciation[]
  absences         Absence[]
  creneauxEdt      CreneauEdt[]
  filsMessages     FilMessage[]
  professeurMatieres ProfesseurMatiere[]

  @@map("matieres")
}

model ProfesseurMatiere {
  id           String @id @default(cuid())
  professeurId String @map("professeur_id")
  matiereId    String @map("matiere_id")

  professeur User    @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  matiere    Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([professeurId, matiereId])
  @@map("professeur_matieres")
}

model ClasseMatiere {
  id           String  @id @default(cuid())
  classeId     String  @map("classe_id")
  matiereId    String  @map("matiere_id")
  professeurId String? @map("professeur_id")
  coefficient  Decimal @default(1.00) @db.Decimal(3, 2)

  classe  Classe  @relation(fields: [classeId], references: [id])
  matiere Matiere @relation(fields: [matiereId], references: [id])

  @@unique([classeId, matiereId])
  @@map("classe_matieres")
}

model Periode {
  id            String   @id @default(cuid())
  nom           String
  numero        Int
  dateDebut     DateTime @map("date_debut")
  dateFin       DateTime @map("date_fin")
  anneeScolaire String   @map("annee_scolaire")
  actif         Boolean  @default(false)
  ordre         Int      @default(0)

  // Relations
  evaluations       Evaluation[]
  bulletins         Bulletin[]
  moyennesMatieres  MoyenneMatiere[]
  moyennesGenerales MoyenneGenerale[]
  appreciations     Appreciation[]

  @@map("periodes")
}

model Evaluation {
  id             String         @id @default(cuid())
  titre          String
  type           TypeEvaluation
  matiereId      String         @map("matiere_id")
  classeId       String         @map("classe_id")
  periodeId      String         @map("periode_id")
  professeurId   String         @map("professeur_id")
  dateEvaluation DateTime       @map("date_evaluation")
  noteSur        Decimal        @default(20.00) @map("note_sur") @db.Decimal(4, 2)
  coefficient    Decimal        @default(1.00) @db.Decimal(3, 2)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Relations
  matiere    Matiere @relation(fields: [matiereId], references: [id])
  classe     Classe  @relation(fields: [classeId], references: [id])
  periode    Periode @relation(fields: [periodeId], references: [id])
  professeur User    @relation(fields: [professeurId], references: [id])
  notes      Note[]

  @@map("evaluations")
}

model Note {
  id           String   @id @default(cuid())
  eleveId      String   @map("eleve_id")
  evaluationId String   @map("evaluation_id")
  note         Decimal? @db.Decimal(4, 2)
  absent       Boolean  @default(false)
  commentaire  String?

  createdAt DateTime  @default(now())
  saisiPar  String    @map("saisi_par")
  deletedAt DateTime?

  // Relations
  eleve      Eleve      @relation(fields: [eleveId], references: [id])
  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  user       User       @relation(fields: [saisiPar], references: [id])

  @@unique([eleveId, evaluationId])
  @@map("notes")
}

model Absence {
  id          String         @id @default(cuid())
  eleveId     String         @map("eleve_id")
  dateAbsence DateTime       @map("date_absence")
  periode     PeriodeJournee @default(JOURNEE)
  dureeHeures Decimal?       @map("duree_heures") @db.Decimal(4, 2)
  matiereId   String?        @map("matiere_id")
  justifiee   Boolean        @default(false)
  motif       String?
  document    String?

  createdAt DateTime  @default(now())
  createdBy String    @map("created_by")
  deletedAt DateTime?

  // Relations
  eleve   Eleve    @relation(fields: [eleveId], references: [id])
  matiere Matiere? @relation(fields: [matiereId], references: [id])
  user    User     @relation(fields: [createdBy], references: [id])

  @@map("absences")
}

model MoyenneMatiere {
  id          String   @id @default(cuid())
  eleveId     String   @map("eleve_id")
  matiereId   String   @map("matiere_id")
  periodeId   String   @map("periode_id")
  moyenne     Decimal? @db.Decimal(4, 2)
  nombreNotes Int      @default(0) @map("nombre_notes")

  updatedAt DateTime @updatedAt

  // Relations
  eleve   Eleve   @relation(fields: [eleveId], references: [id])
  matiere Matiere @relation(fields: [matiereId], references: [id])
  periode Periode @relation(fields: [periodeId], references: [id])

  @@unique([eleveId, matiereId, periodeId])
  @@map("moyennes_matieres")
}

model MoyenneGenerale {
  id                String   @id @default(cuid())
  eleveId           String   @map("eleve_id")
  periodeId         String   @map("periode_id")
  moyenneGenerale   Decimal? @map("moyenne_generale") @db.Decimal(4, 2)
  rangClasse        Int?     @map("rang_classe")
  totalPoints       Decimal? @map("total_points") @db.Decimal(8, 2)
  totalCoefficients Decimal? @map("total_coefficients") @db.Decimal(6, 2)
  mention           String?

  updatedAt DateTime @updatedAt

  // Relations
  eleve   Eleve   @relation(fields: [eleveId], references: [id])
  periode Periode @relation(fields: [periodeId], references: [id])

  @@unique([eleveId, periodeId])
  @@map("moyennes_generales")
}

model Appreciation {
  id           String           @id @default(cuid())
  eleveId      String           @map("eleve_id")
  matiereId    String?          @map("matiere_id")
  periodeId    String           @map("periode_id")
  type         TypeAppreciation
  appreciation String
  auteurId     String           @map("auteur_id")

  createdAt DateTime @default(now())

  // Relations
  eleve   Eleve    @relation(fields: [eleveId], references: [id])
  matiere Matiere? @relation(fields: [matiereId], references: [id])
  periode Periode  @relation(fields: [periodeId], references: [id])

  @@map("appreciations")
}

model Bulletin {
  id               String    @id @default(cuid())
  eleveId          String    @map("eleve_id")
  periodeId        String    @map("periode_id")
  tokenQr          String    @unique @map("token_qr")
  fichierPdf       String?   @map("fichier_pdf")
  hashVerification String?   @map("hash_verification")

  createdAt DateTime  @default(now())
  generePar String    @map("genere_par")
  deletedAt DateTime?

  // Relations
  eleve   Eleve   @relation(fields: [eleveId], references: [id])
  periode Periode @relation(fields: [periodeId], references: [id])
  user    User    @relation(fields: [generePar], references: [id])

  @@unique([eleveId, periodeId])
  @@map("bulletins")
}

model Parametre {
  id          String  @id @default(cuid())
  cle         String  @unique
  valeur      String?
  description String?
  type        String  @default("string")

  updatedAt DateTime @updatedAt

  @@map("parametres")
}

model LogActivite {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  table     String?
  recordId  String?  @map("record_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("logs_activite")
}

model Notification {
  id      String    @id @default(cuid())
  userId  String    @map("user_id")
  type    String
  title   String
  message String
  data    Json?
  readAt  DateTime? @map("read_at")

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model CreneauEdt {
  id           String      @id @default(cuid())
  ecoleId      String      @map("ecole_id")
  classeId     String      @map("classe_id")
  jour         JourSemaine
  heureDebut   String      @map("heure_debut")
  heureFin     String      @map("heure_fin")
  matiereId    String      @map("matiere_id")
  professeurId String?     @map("professeur_id")
  salle        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ecole      Ecole   @relation(fields: [ecoleId], references: [id])
  classe     Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere    Matiere @relation(fields: [matiereId], references: [id])
  professeur User?   @relation(fields: [professeurId], references: [id])

  @@index([ecoleId])
  @@index([classeId, jour])
  @@unique([classeId, jour, heureDebut, heureFin])
  @@map("creneaux_edt")
}

model Communique {
  id            String                 @id @default(cuid())
  ecoleId       String                 @map("ecole_id")
  auteurId      String                 @map("auteur_id")
  titre         String
  corps         String                 @db.Text
  urgent        Boolean                @default(false)
  destinataires DestinataireCommunique
  familleCycle  FamilleCycle?          @map("famille_cycle")

  createdAt DateTime @default(now())

  ecole  Ecole @relation(fields: [ecoleId], references: [id])
  auteur User  @relation(fields: [auteurId], references: [id])

  @@index([ecoleId, createdAt])
  @@map("communiques")
}

model EvenementJour {
  id       String             @id @default(cuid())
  ecoleId  String             @map("ecole_id")
  date     DateTime
  type     TypeEvenementJour
  titre    String?
  detail   String?
  userId   String?            @map("user_id")
  auteurId String             @map("auteur_id")

  createdAt DateTime @default(now())

  ecole  Ecole @relation(fields: [ecoleId], references: [id])
  user   User? @relation("EvenementPersonnel", fields: [userId], references: [id])
  auteur User  @relation("EvenementAuteur", fields: [auteurId], references: [id])

  @@index([ecoleId, date])
  @@map("evenements_jour")
}

model NoteAgenda {
  id       String   @id @default(cuid())
  ecoleId  String   @map("ecole_id")
  auteurId String   @map("auteur_id")
  titre    String
  corps    String   @db.Text
  date     DateTime

  createdAt DateTime @default(now())

  ecole  Ecole @relation(fields: [ecoleId], references: [id])
  auteur User  @relation(fields: [auteurId], references: [id])

  @@index([ecoleId, date])
  @@map("notes_agenda")
}

model FilMessage {
  id           String  @id @default(cuid())
  ecoleId      String  @map("ecole_id")
  eleveId      String  @map("eleve_id")
  parentId     String  @map("parent_id")
  professeurId String  @map("professeur_id")
  matiereId    String? @map("matiere_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ecole      Ecole    @relation(fields: [ecoleId], references: [id])
  eleve      Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  parent     User     @relation("FilParent", fields: [parentId], references: [id])
  professeur User     @relation("FilProfesseur", fields: [professeurId], references: [id])
  matiere    Matiere? @relation(fields: [matiereId], references: [id])
  messages   Message[]

  @@unique([eleveId, parentId, professeurId])
  @@index([ecoleId])
  @@map("fils_messages")
}

model Message {
  id       String    @id @default(cuid())
  filId    String    @map("fil_id")
  auteurId String    @map("auteur_id")
  corps    String    @db.Text
  luAt     DateTime? @map("lu_at")

  createdAt DateTime @default(now())

  fil    FilMessage @relation(fields: [filId], references: [id], onDelete: Cascade)
  auteur User       @relation(fields: [auteurId], references: [id])

  @@index([filId, createdAt])
  @@map("messages")
}

model FilStaff {
  id          String @id @default(cuid())
  ecoleId     String @map("ecole_id")
  directeurId String @map("directeur_id")
  prefetId    String @map("prefet_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ecole     Ecole          @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  directeur User           @relation("FilStaffDirecteur", fields: [directeurId], references: [id])
  prefet    User           @relation("FilStaffPrefet", fields: [prefetId], references: [id])
  messages  MessageStaff[]

  @@unique([directeurId, prefetId])
  @@index([ecoleId])
  @@map("fils_staff")
}

model MessageStaff {
  id       String    @id @default(cuid())
  filId    String    @map("fil_id")
  auteurId String    @map("auteur_id")
  corps    String    @db.Text
  luAt     DateTime? @map("lu_at")

  createdAt DateTime @default(now()) @map("created_at")

  fil    FilStaff @relation(fields: [filId], references: [id], onDelete: Cascade)
  auteur User     @relation(fields: [auteurId], references: [id])

  @@index([filId, createdAt])
  @@map("messages_staff")
}

model TokenRevocation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("token_revocations")
}

model LoginAttempt {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  identifier String
  ipAddress  String   @map("ip_address")
  success    Boolean
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@index([identifier, createdAt])
  @@map("login_attempts")
}

// ============== PAIEMENTS ==============

enum StatutPaiement {
  PAYE
  PARTIEL
  NON_PAYE
}

enum TypeFrais {
  INSCRIPTION
  SCOLARITE
  CANTINE
  TRANSPORT
  AUTRE
}

model Paiement {
  id            String         @id @default(cuid())
  eleveId       String         @map("eleve_id")
  typeFrais     TypeFrais      @map("type_frais")
  montantTotal  Decimal        @map("montant_total") @db.Decimal(10, 2)
  montantPaye   Decimal        @default(0) @map("montant_paye") @db.Decimal(10, 2)
  statut        StatutPaiement @default(NON_PAYE)
  anneeScolaire String         @map("annee_scolaire")
  echeance      DateTime?
  description   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  eleve       Eleve             @relation(fields: [eleveId], references: [id])
  versements  VersementPaiement[]

  @@map("paiements")
}

model VersementPaiement {
  id          String   @id @default(cuid())
  paiementId  String   @map("paiement_id")
  montant     Decimal  @db.Decimal(10, 2)
  datePaiement DateTime @map("date_paiement")
  modePaiement String   @map("mode_paiement") // especes, cheque, virement, wave, orange_money
  reference   String?
  recuPar     String?  @map("recu_par")

  createdAt DateTime @default(now())

  // Relations
  paiement Paiement @relation(fields: [paiementId], references: [id], onDelete: Cascade)

  @@map("versements_paiements")
}
