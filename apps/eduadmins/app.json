{
  "expo": {
    "name": "EduAdmins",
    "slug": "eduadmins",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "eduadmins",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sn.novaholdings.eduadmins"
    },
    "android": {
      "package": "sn.novaholdings.eduadmins",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A5FD4"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
